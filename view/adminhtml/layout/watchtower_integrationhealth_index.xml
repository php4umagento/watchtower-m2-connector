<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="formkey"/>
    <head>
        <css src="Watchtower_Connector::css/integrations.css"/>
    </head>
    <body>
        <referenceContainer name="content">
            <block class="Magento\Backend\Block\Template"
                   name="watchtower.integrationhealth.integrations"
                   template="Watchtower_Connector::integrationhealth/integrations.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">
                        Watchtower\Connector\ViewModel\IntegrationHealth\Integrations
                    </argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
