/** @var \Watchtower\Connector\Block\Adminhtml\Diagnostics\Overview $block */
/** @var \Magento\Framework\Escaper $escaper */
$snapshot = $block->getSnapshot();
$plain = $block->plain();
$now = $block->now();
$overall = $plain->overall($snapshot, $now);
$notices = $plain->notices($snapshot);
?>
<div id="watchtower_diagnostics">
    <div class="messages">
        <div class="message <?= $escaper->escapeHtmlAttr($block->messageClass($overall)) ?>">
            <div>
                <strong><?= $escaper->escapeHtml($overall->label) ?></strong>
                <?php if ($overall->detail !== ''): ?>
                    <br><?= $escaper->escapeHtml($overall->detail) ?>
                <?php endif; ?>
            </div>
        </div>
        <?php foreach ($notices as $notice): ?>
            <div class="message <?= $escaper->escapeHtmlAttr($block->messageClass($notice)) ?>">
                <div>
                    <?= $escaper->escapeHtml($notice->label) ?>
                    <?= $escaper->escapeHtml($notice->detail) ?>
                </div>
            </div>
        <?php endforeach; ?>
    </div>

    <?php if ($snapshot->reachable): ?>
        <p>
            <?= $escaper->escapeHtml(__('Last report sent to Watchtower:')) ?>
            <strong><?= $escaper->escapeHtml($plain->ago($snapshot->lastSuccessfulSubmissionAt, $now)) ?></strong>
        </p>
    <?php endif; ?>

    <div class="admin__fieldset-wrapper">
        <div class="admin__fieldset-wrapper-title">
            <strong><?= $escaper->escapeHtml(__('Your whole shop')) ?></strong>
        </div>
        <table class="data-grid">
            <thead>
            <tr>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('What is checked')) ?></th>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('Status')) ?></th>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('What it means')) ?></th>
            </tr>
            </thead>
            <tbody>
            <?php $cron = $plain->signal($snapshot->cronHealth); ?>
            <tr>
                <td class="data-grid-td">
                    <strong><?= $escaper->escapeHtml($plain->name($snapshot->cronHealth->category)) ?></strong><br>
                    <?= $escaper->escapeHtml($plain->description($snapshot->cronHealth->category)) ?>
                </td>
                <td class="data-grid-td">
                    <span class="<?= $escaper->escapeHtmlAttr($block->badgeClass($cron)) ?>">
                        <span><?= $escaper->escapeHtml($cron->label) ?></span>
                    </span>
                </td>
                <td class="data-grid-td"><?= $escaper->escapeHtml($cron->detail) ?></td>
            </tr>
            </tbody>
        </table>
    </div>

    <?php // One collapsible block per store view keeps the page short on shops with many. One with
    // something wrong opens by itself so a real problem is never hidden behind a click. ?>
    <?php foreach ($snapshot->storeViews as $storeView): ?>
        <?php $needsAttention = $plain->storeViewNeedsAttention($storeView); ?>
        <details class="details admin__collapsible-block-wrapper"<?= $needsAttention ? ' open' : '' ?>>
            <summary class="details-summary admin__collapsible-title">
                <span><?= $escaper->escapeHtml($storeView->storeViewCode) ?></span>
                <?php if ($needsAttention): ?>
                    <strong class="watchtower-eol-warning"><?= $escaper->escapeHtml(__('Needs attention')) ?></strong>
                <?php elseif ($plain->storeViewLearning($storeView)): ?>
                    <span><?= $escaper->escapeHtml(__('Still learning')) ?></span>
                <?php endif; ?>
            </summary>
            <div class="details-content admin__fieldset">
                <table class="data-grid">
                    <thead>
                    <tr>
                        <th class="data-grid-th"><?= $escaper->escapeHtml(__('What is checked')) ?></th>
                        <th class="data-grid-th"><?= $escaper->escapeHtml(__('Status')) ?></th>
                        <th class="data-grid-th"><?= $escaper->escapeHtml(__('What it means')) ?></th>
                    </tr>
                    </thead>
                    <tbody>
                    <?php foreach ($storeView->signals as $signal): ?>
                        <?php $state = $plain->signal($signal); ?>
                        <tr>
                            <td class="data-grid-td">
                                <strong><?= $escaper->escapeHtml($plain->name($signal->category)) ?></strong><br>
                                <?= $escaper->escapeHtml($plain->description($signal->category)) ?>
                            </td>
                            <td class="data-grid-td">
                                <span class="<?= $escaper->escapeHtmlAttr($block->badgeClass($state)) ?>">
                                    <span><?= $escaper->escapeHtml($state->label) ?></span>
                                </span>
                            </td>
                            <td class="data-grid-td"><?= $escaper->escapeHtml($state->detail) ?></td>
                        </tr>
                    <?php endforeach; ?>
                    </tbody>
                </table>
            </div>
        </details>
    <?php endforeach; ?>
</div>
