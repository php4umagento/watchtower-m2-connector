<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="customer_login">
        <observer name="watchtower_customer_login_counter"
                  instance="Watchtower\Connector\Model\EventCounter\CustomerSessionObserver"/>
    </event>
    <event name="customer_logout">
        <observer name="watchtower_customer_logout_counter"
                  instance="Watchtower\Connector\Model\EventCounter\CustomerSessionObserver"/>
    </event>
    <event name="watchtower_integration_health">
        <observer name="watchtower_integration_health_event_snapshot"
                  instance="Watchtower\Connector\Model\IntegrationHealth\ConventionEventObserver"/>
    </event>
    <!--
        Deliberately declared here, in the global area, not in etc/frontend.
        Luma's checkout POSTs to /V1/carts/mine/payment-information, which runs
        in webapi_rest, and GraphQL placeOrder runs in graphql, so a
        frontend-scoped observer would see none of the failures this signal
        exists to catch. This is a knowing deviation from Adobe technical
        guideline 14.2 ("observe as specifically as possible"), which is
        written for feature extensions rather than for monitoring.
    -->
    <event name="sales_model_service_quote_submit_failure">
        <observer name="watchtower_checkout_failure_counter"
                  instance="Watchtower\Connector\Model\EventCounter\CheckoutFailureObserver"/>
    </event>
    <!--
        Global rather than etc/adminhtml, even though admin sign-in only
        ever happens in the adminhtml area in practice: matches this
        module's other observers rather than being a special case, and
        costs nothing extra since this event is already low-frequency by
        nature. Two dispatch sites in core, both sharing this event name and
        payload shape, so one binding covers both: Backend\Model\Auth::login()
        (password) and AdminAdobeIms\Model\Auth::login() (SSO, only present
        when that feature is configured).
    -->
    <event name="backend_auth_user_login_failed">
        <observer name="watchtower_admin_auth_failure_counter"
                  instance="Watchtower\Connector\Model\AdminAuthFailure\AdminAuthFailureObserver"/>
    </event>
</config>
